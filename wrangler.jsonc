{
  // Cloudflare Worker for LinkHub.
  // Secrets (set with `npx wrangler secret put NAME`): DATABASE_URL, ADMIN_PASSWORD.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linkhub",
  "main": "src/index.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request goes through the Worker first so pages and the API get the same
    // security headers, and the link page can be filled in for the signed-in family.
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  // Served at links.kittigutierrez.com and links.jamry.us (Cloudflare creates the DNS records
  // and certificates), from the ann3mari37@gmail.com account. Each address has its own sign-in,
  // since cookies belong to one domain.
  "account_id": "1ee0ccf466cef622b87273a6b7d79056",
  "routes": [
    { "pattern": "links.kittigutierrez.com", "custom_domain": true },
    { "pattern": "links.jamry.us", "custom_domain": true }
  ],

  // TEMPORARY, until jamry.us finishes moving into the gmail account: jamry.us is still
  // served from the annemarie@ohrrenova.com account, and a Worker can only use a domain from
  // its own account, so the same code is deployed there as well:
  //   npx wrangler deploy --env jamry          (signed in to wrangler as annemarie@ohrrenova.com)
  // It uses the same Supabase database, so both addresses show the same families and links.
  // Once jamry.us's nameservers are alec/ariella.ns.cloudflare.com, the gmail Worker above
  // answers for links.jamry.us; then delete the ohrrenova "linkhub" Worker and this block.
  "env": {
    "jamry": {
      "name": "linkhub",
      "account_id": "cd54bbe8e919bce7ccdf2e34df768273",
      "routes": [{ "pattern": "links.jamry.us", "custom_domain": true }]
    }
  }

  // Recommended: Hyperdrive pools connections to Supabase close to your users.
  // Create it with: npx wrangler hyperdrive create linkhub-db --connection-string="<Supabase connection string>"
  // then uncomment and paste the id it prints:
  // ,"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<your-hyperdrive-id>" }]
}
