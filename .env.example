# Copy to .env for local development (`npm run dev`). On Railway, set these as service variables.

# Railway Postgres. On Railway use the reference variable: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:password@localhost:5432/linkhub
# PGSSL=require   # only if connecting over Railway's public proxy URL

# Long random string; keeps people signed in across restarts.
SESSION_SECRET=change-me-to-a-long-random-string

# Password for /admin, where families are created. Leave empty to switch the admin page off.
ADMIN_PASSWORD=

# The word typed to confirm a delete (default: yes).
# DELETE_WORD=yes
