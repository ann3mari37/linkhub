{
  "name": "linkhub",
  "version": "2.0.0",
  "private": true,
  "description": "Your family's links, all in one place — Cloudflare Workers + Supabase",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "copy-from-railway": "node --env-file=.env scripts/copy-from-railway.mjs"
  },
  "dependencies": {
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "wrangler": "4.49.1"
  },
  "engines": {
    "node": ">=20"
  }
}
